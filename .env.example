# Credora Environment Configuration

# Optional: Custom Production App URL (defaults to window.location.origin if omitted)
# Used to encode the QR verification destination link: e.g. https://credora.vercel.app
VITE_APP_URL=https://credora.vercel.app

# Firebase Firestore Configuration for Certificate Registry
# Obtain credentials from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
